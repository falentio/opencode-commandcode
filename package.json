{
  "name": "@falentio/opencode-commandcode",
  "type": "module",
  "version": "0.4.1",
  "description": "OpenCode plugin for CommandCode",
  "author": "falentio <confirmkevin@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/falentio/opencode-commandcode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falentio/opencode-commandcode.git"
  },
  "bugs": {
    "url": "https://github.com/falentio/opencode-commandcode/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "commandcode"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./server": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "models:refresh": "node scripts/generate-model-metadata.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.41"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.30",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@12.4.1"
}
